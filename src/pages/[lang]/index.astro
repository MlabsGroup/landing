---
import Layout from '../../layouts/Layout.astro';
import { LANGS, company, copy, isValidLang, type Lang } from '../../i18n/content';

export const prerender = true;

export const getStaticPaths = () => {
  return LANGS.map((lang) => ({ params: { lang } }));
};

const rawLang = Astro.params.lang ?? 'es';

if (!isValidLang(rawLang)) {
  throw new Error(`Unsupported locale: ${rawLang}`);
}

const lang = rawLang as Lang;
const t = copy[lang];
const tab = t.tabs.investor;
---

<Layout lang={lang} title={t.siteTitle} description={t.siteDescription}>
  <!-- HERO -->
  <section class="wrap hero">
    <div class="hero-grid">
      <div class="hero-main">
        <div class="kicker eyebrow"><span class="dot"></span>{t.eyebrow}</div>
        <h1 class="display">{t.heroTitle}<span class="accent">{t.heroTitleAccent}</span></h1>
        <p class="hero-text">{t.heroText}</p>
      </div>

      <div class="hero-panel">
        <div class="hero-panel-head">
          <span>{t.heroPanelTitle}</span>
          <span class="live">Live</span>
        </div>
        {
          t.heroRows.map((row) => (
            <div class="hero-row">
              <div>
                <div class="hero-row-name">{row.name}</div>
                <div class="hero-row-what">{row.what}</div>
              </div>
              {row.markets && <div class="hero-row-markets">{row.markets}</div>}
            </div>
          ))
        }
        <a href="#portfolio" class="hero-panel-link">
          {t.heroPanelLink}
          <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>

    <div class="doors">
      {
        t.doors.map((d) => (
          <a href="#formulario" class="door" data-tab={d.tab}>
            <span class="door-who">{d.who}</span>
            <span class="door-verb">{d.verb}</span>
            <span class="door-body">{d.body}</span>
            <span class="door-cta">
              {d.cta}
              <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- STATS -->
  <section class="dark">
    <div class="wrap stats">
      {
        t.stats.map((s) => (
          <div>
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 01 VISIÓN -->
  <section id="vision" class="wrap section">
    <div class="split">
      <div class="split-side kicker">{t.visionKicker}</div>
      <div class="split-main">
        <h2 class="vision-title">{t.visionTitle}</h2>
        <p class="lead vision-text">{t.visionText}</p>
      </div>
    </div>

    <div class="how">
      <div class="block-head">
        <h3 class="display">{t.howTitle[0]}<br />{t.howTitle[1]}</h3>
        <p>{t.howText}</p>
      </div>
      <div class="grid grid-260">
        {
          t.steps.map((s) => (
            <div class="card step">
              <div class="step-n">{s.n}</div>
              <div class="step-title">{s.title}</div>
              <div class="step-body">{s.body}</div>
              <div class="step-gate">{s.gate}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MLABS CORE -->
  <section class="core">
    <div class="wrap">
      <div class="core-intro">
        <div class="kicker">MLabs Core</div>
        <h3>{t.coreTitle}</h3>
        <p>{t.coreText}</p>
      </div>
      <div class="core-grid">
        {
          t.core.map((c) => (
            <div class="core-item">
              <div class="item-title">{c.title}</div>
              <div class="item-body">{c.body}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 02 QUIÉNES SOMOS -->
  <section id="nosotros" class="wrap section">
    <div class="split">
      <div class="about-head">
        <div class="kicker">{t.aboutKicker}</div>
        <h2 class="display about-title">{t.aboutTitle}</h2>
      </div>
      <div class="about-text lead">
        {t.aboutText.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <div class="grid grid-260 team">
      {
        t.team.map((m) => (
          <div class="card member">
            <div class="avatar" aria-hidden="true">{m.initials}</div>
            <div>
              <div class="member-name">{m.name}</div>
              <div class="member-role">{m.role}</div>
              <div class="item-body">{m.body}</div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="values">
      {
        t.values.map((v) => (
          <div class="value">
            <div class="item-title">{v.title}</div>
            <div class="item-body">{v.body}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 03 PORTFOLIO -->
  <section id="portfolio" class="portfolio">
    <div class="wrap section">
      <div class="block-head">
        <div>
          <div class="kicker">{t.portfolioKicker}</div>
          <h2 class="display">{t.portfolioTitle[0]}<br />{t.portfolioTitle[1]}</h2>
        </div>
        <div role="group" aria-label={t.filterLabel} class="filters">
          {
            t.filters.map((f) => (
              <button type="button" class="pill" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>
                {f.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="ventures">
        {
          t.ventures.map((v) => (
            <article class="venture" data-group={v.group}>
              <div class="venture-top">
                <span class="badge">{v.status}</span>
                {v.markets && <span class="venture-markets">{v.markets}</span>}
              </div>
              <h3>{v.name}</h3>
              {v.category && <div class="venture-category">{v.category}</div>}
              <p>{v.body}</p>
              {v.proof && <div class="venture-proof">{v.proof}</div>}
            </article>
          ))
        }
      </div>
      <p class="acq">{t.acqText} <a href="#formulario" data-tab="acquisition">{t.acqLink}</a></p>
    </div>
  </section>

  <!-- 04 CONTACTO -->
  <section id="contacto" class="contact dark">
    <div class="wrap">
      <div class="kicker">{t.contactKicker}</div>
      <h2 class="display">{t.contactTitle}</h2>
      <p class="contact-intro">{t.contactText}</p>

      <div class="audiences">
        {
          t.audiences.map((a) => (
            <div class="audience">
              <div class="audience-who">{a.who}</div>
              <div class="audience-title">{a.title}</div>
              <div class="audience-body">{a.body}</div>
              <ul>
                {a.points.map((p) => (
                  <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C8BBF7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              <a href="#formulario" class="btn" data-tab={a.tab}>{a.cta}</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="formulario" class="form-section">
    <div class="wrap">
      <div class="form-intro">
        <h3 class="display">{t.formTitle}</h3>
        <p>{t.formText}</p>
        <ul class="direct">
          <li>
            <div class="direct-label">{t.emailLabel}</div>
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </li>
          <li>
            <div class="direct-label">{t.phoneLabel}</div>
            <a href={company.phoneHref}>{company.phone}</a>
          </li>
          <li>
            <div class="direct-label">{t.addressLabel}</div>
            <span>{company.legalName}<br />{company.street}, {company.postalCode} {company.city}, {t.countryName}</span>
          </li>
        </ul>
      </div>

      <div class="form-card" data-contact data-email={company.email} data-tabs={JSON.stringify(t.tabs)}>
        <div role="tablist" aria-label={t.formTabsLabel} class="tabs">
          {
            (Object.keys(t.tabs) as (keyof typeof t.tabs)[]).map((key) => (
              <button type="button" role="tab" class="pill" data-tab-key={key} aria-selected={key === 'investor' ? 'true' : 'false'}>
                {t.tabs[key].label}
              </button>
            ))
          }
        </div>

        <form
          data-form
          action={`mailto:${company.email}`}
          method="post"
          enctype="text/plain"
        >
          <div class="form-title" data-slot="title">{tab.title}</div>
          <div class="form-lead" data-slot="lead">{tab.lead}</div>
          <div class="fields">
            <label class="field">{t.fieldName}
              <input type="text" name="nombre" autocomplete="name" required />
            </label>
            <label class="field">{t.fieldEmail}
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label class="field"><span data-slot="orgLabel">{tab.orgLabel}</span>
              <input type="text" name="organizacion" />
            </label>
            <label class="field">{t.fieldWeb}
              <input type="text" name="web" />
            </label>
          </div>
          <label class="field field-full"><span data-slot="msgLabel">{tab.msgLabel}</span>
            <textarea name="mensaje" rows="4" required></textarea>
          </label>
          <button type="submit" class="submit" data-slot="cta">{tab.cta}</button>
        </form>

        <div class="sent" data-sent hidden>
          <div class="sent-title">{t.formSentTitle}</div>
          <p>{t.formSentText}</p>
          <button type="button" data-reset>{t.formReset}</button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Filtro del portfolio
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const ventures = document.querySelectorAll<HTMLElement>('.venture');
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      filterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      ventures.forEach((v) => {
        v.hidden = filter !== 'all' && v.dataset.group !== filter;
      });
    });
  });

  // Formulario de contacto: pestañas por tipo de contacto y envío vía mailto
  const card = document.querySelector<HTMLElement>('[data-contact]');
  if (card) {
    const tabs = JSON.parse(card.dataset.tabs ?? '{}') as Record<string, Record<string, string>>;
    const email = card.dataset.email ?? '';
    const form = card.querySelector<HTMLFormElement>('[data-form]')!;
    const sent = card.querySelector<HTMLElement>('[data-sent]')!;
    const tabButtons = card.querySelectorAll<HTMLButtonElement>('[data-tab-key]');
    let active = 'investor';

    const selectTab = (key: string) => {
      if (!tabs[key]) return;
      active = key;
      tabButtons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tabKey === key)));
      form.querySelectorAll<HTMLElement>('[data-slot]').forEach((el) => {
        el.textContent = tabs[key][el.dataset.slot!];
      });
      form.hidden = false;
      sent.hidden = true;
    };

    tabButtons.forEach((b) => b.addEventListener('click', () => selectTab(b.dataset.tabKey!)));
    document.querySelectorAll<HTMLElement>('a[data-tab]').forEach((a) => {
      a.addEventListener('click', () => selectTab(a.dataset.tab!));
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const tab = tabs[active];
      const lines = [
        `${tab.label}`,
        '',
        `Nombre / Name: ${data.get('nombre')}`,
        `Email: ${data.get('email')}`,
        `${tab.orgLabel}: ${data.get('organizacion')}`,
        `LinkedIn / Web: ${data.get('web')}`,
        '',
        `${tab.msgLabel}`,
        `${data.get('mensaje')}`,
      ];
      const subject = `MLABS · ${tab.title}`;
      const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
      form.dataset.mailto = mailto; // usado por los tests e2e
      window.location.href = mailto;
      form.hidden = true;
      sent.hidden = false;
    });

    card.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      selectTab(active);
    });
  }
</script>
