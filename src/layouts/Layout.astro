---
import '../styles/global.css';
import HeaderNav from '../components/HeaderNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { company, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string;
}

const { lang, title, description, path = '' } = Astro.props;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MLABS Group',
  legalName: company.legalName,
  url: company.siteUrl,
  email: company.email,
  telephone: company.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.postalCode,
    addressLocality: company.city,
    addressCountry: company.countryCode,
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" hreflang="es" href={`/es/${path}`} />
    <link rel="alternate" hreflang="en" href={`/en/${path}`} />
    <link rel="alternate" hreflang="x-default" href={`/es/${path}`} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>

  <body>
    <HeaderNav lang={lang} path={path} />
    <main id="top"><slot /></main>
    <SiteFooter lang={lang} />
  </body>
</html>
