---
interface Props {
  sectionId?: string;
  title: string;
  intro: string;
  acquisitionTitle: string;
  acquisitionText: string;
  acquisitionButton: string;
  juniorTitle: string;
  juniorText: string;
  juniorButton: string;
}

const {
  sectionId = 'opportunities',
  title,
  intro,
  acquisitionTitle,
  acquisitionText,
  acquisitionButton,
  juniorTitle,
  juniorText,
  juniorButton,
} = Astro.props;

const acquisitionEmail = 'mailto:tech@mlabsgroup.com?subject=Adquisicion%20de%20Software%20B2B';
const juniorEmail = 'mailto:tech@mlabsgroup.com?subject=Aplicacion%20Junior%20Partners';
---

<section id={sectionId} class="py-24 md:py-28" data-section>
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <div class="max-w-3xl" data-reveal>
      <h2 class="section-title">{title}</h2>
      <p class="section-copy mt-5">{intro}</p>
    </div>

    <div class="mt-12 flex flex-col gap-7 md:flex-row">
      <article
        class="glass-premium with-border-beam group relative flex h-full flex-1 flex-col justify-between overflow-hidden rounded-3xl border border-blue-200/50 p-8 shadow-glow transition-all duration-500 hover:shadow-glow-lg hover:-translate-y-2 md:p-10"
        data-card
        data-tilt
        data-reveal
      >
        <div class="pointer-events-none absolute -left-20 top-8 h-44 w-44 rounded-full bg-blue-300/30 blur-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100 card-glow"></div>
        <div>
          <h3 class="text-2xl font-semibold tracking-[-0.02em] text-slate-900">{acquisitionTitle}</h3>
          <p class="mt-5 text-sm leading-relaxed text-slate-700 md:text-base">{acquisitionText}</p>
        </div>

        <a
          class="mt-10 inline-flex w-fit items-center rounded-full border border-blue-300 bg-blue-50 px-5 py-3 text-sm font-medium text-blue-600 transition hover:bg-blue-100 hover:border-blue-400 focus-visible:ring-2 focus-visible:ring-blue-400"
          href={acquisitionEmail}
          aria-label="Enviar correo para explorar adquisicion de software"
        >
          {acquisitionButton}
        </a>
      </article>

      <article
        class="glass-premium with-border-beam group relative flex h-full flex-1 flex-col justify-between overflow-hidden rounded-3xl border border-blue-200/50 p-8 shadow-glow transition-all duration-500 hover:shadow-glow-lg hover:-translate-y-2 md:p-10"
        data-card
        data-tilt
        data-reveal
      >
        <div class="pointer-events-none absolute -right-20 bottom-8 h-44 w-44 rounded-full bg-blue-300/30 blur-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100 card-glow"></div>
        <div>
          <h3 class="text-2xl font-semibold tracking-[-0.02em] text-slate-900">{juniorTitle}</h3>
          <p class="mt-5 text-sm leading-relaxed text-slate-700 md:text-base">{juniorText}</p>
        </div>

        <a
          class="mt-10 inline-flex w-fit items-center rounded-full border border-blue-300 bg-blue-50 px-5 py-3 text-sm font-medium text-blue-600 transition hover:bg-blue-100 hover:border-blue-400 focus-visible:ring-2 focus-visible:ring-blue-400"
          href={juniorEmail}
          aria-label="Enviar correo para aplicar a Junior Partners"
        >
          {juniorButton}
        </a>
      </article>
    </div>
  </div>
</section>

