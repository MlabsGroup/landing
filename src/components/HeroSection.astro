---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  primaryButton: string;
  secondaryButton: string;
  visualAlt: string;
}

const { eyebrow, title, subtitle, primaryButton, secondaryButton, visualAlt } = Astro.props;
---

<section id="hero" class="relative overflow-hidden pb-24 pt-40 md:pb-32 md:pt-44" data-section>
  <div class="pointer-events-none absolute inset-0 -z-10" data-parallax>
    <div class="absolute left-[-8%] top-[10%] h-[24rem] w-[24rem] rounded-full bg-sky-200/15 blur-[140px]"></div>
    <div class="absolute bottom-[-8%] right-[-10%] h-[26rem] w-[26rem] rounded-full bg-indigo-200/12 blur-[160px]"></div>
  </div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-6 md:grid-cols-12 md:items-center md:gap-8 md:px-10">
    <div class="md:col-span-7">
      <p
        class="mb-7 inline-flex items-center rounded-full border border-blue-300/50 bg-blue-50 px-4 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-blue-700"
        data-reveal
      >
        {eyebrow}
      </p>

      <h1
        class="text-balance text-4xl font-semibold leading-[0.94] tracking-[-0.035em] text-slate-900 sm:text-6xl md:text-[4.5rem] lg:text-[5.15rem]"
        data-reveal
        data-split
      >
        {title}
      </h1>

      <p
        class="mt-8 max-w-2xl text-pretty text-base leading-relaxed text-slate-700 sm:text-lg md:text-[1.22rem]"
        data-reveal
      >
        {subtitle}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3.5" data-reveal>
        <a
          href="mailto:tech@mlabsgroup.com?subject=MLABS%20-%20Conversacion%20estrategica"
          class="inline-flex items-center rounded-full border border-blue-300 bg-blue-600 px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-blue-700 shadow-md hover:shadow-lg"
          aria-label="Enviar correo para iniciar conversacion estrategica"
        >
          {primaryButton}
        </a>

        <a
          href="#how"
          class="inline-flex items-center rounded-full border border-slate-300 bg-slate-100 px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-slate-700 transition hover:bg-slate-200"
          aria-label="Ir a la seccion de plataforma"
        >
          {secondaryButton}
        </a>
      </div>
    </div>

    <div class="md:col-span-5" data-reveal data-hero-visual>
      <div
        class="glass-premium with-border-beam relative overflow-hidden rounded-3xl border border-blue-200/50 p-4 shadow-glow-lg md:p-5 transition-all duration-300"
        data-tilt
      >
        <img
          src="/images/mlabs-orbit-visual.svg"
          alt={visualAlt}
          class="relative z-10 w-full rounded-2xl border border-blue-200/30"
          loading="eager"
          decoding="async"
        />

        <div
          class="pointer-events-none absolute left-5 top-5 rounded-full border border-white/25 bg-slate-900/55 px-3 py-1.5 text-[0.62rem] font-medium uppercase tracking-[0.2em] text-white/80"
          data-float-chip
        >
          Distribution Engine
        </div>
        <div
          class="pointer-events-none absolute bottom-5 right-5 rounded-full border border-white/25 bg-slate-900/55 px-3 py-1.5 text-[0.62rem] font-medium uppercase tracking-[0.2em] text-white/80"
          data-float-chip
        >
          Multi-Market Ops
        </div>
      </div>
    </div>
  </div>
</section>
