---
interface Props {
  kicker: string;
  title: string;
  text: string;
  points: string[];
  imageAlt: string;
}

const { kicker, title, text, points, imageAlt } = Astro.props;
---

<section class="py-24 md:py-28" data-section>
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:items-center">
      <div
        class="glass-premium with-border-beam relative overflow-hidden rounded-3xl border border-blue-200/50 p-4 shadow-glow-lg md:col-span-6 md:p-6 transition-all duration-300"
        data-reveal
        data-tilt
      >
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(59,130,246,0.1),transparent_45%),radial-gradient(circle_at_85%_80%,rgba(168,85,247,0.08),transparent_42%)]"></div>
        <img
          src="/images/mlabs-expansion-console.svg"
          alt={imageAlt}
          class="relative z-10 w-full rounded-2xl border border-blue-200/40"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="md:col-span-6">
        <p class="section-kicker" data-reveal>{kicker}</p>
        <h2 class="section-title mt-4" data-reveal>{title}</h2>
        <p class="section-copy mt-6" data-reveal>{text}</p>

        <ul class="mt-7 space-y-3" role="list">
          {
            points.map((point) => (
              <li
                class="glass-card rounded-xl border border-white/15 px-4 py-3 text-sm leading-relaxed text-white/84 md:text-base"
                data-reveal
              >
                <span class="mr-2 inline-flex h-5 w-5 items-center justify-center rounded-full border border-white/25 text-[0.65rem] text-white/80">
                  +
                </span>
                {point}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
