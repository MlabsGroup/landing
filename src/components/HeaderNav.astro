---
import { copy, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = copy[lang];
const home = `/${lang}/`;
---

<header class="site-header">
  <div class="wrap">
    <a href={`${home}#top`} class="logo" aria-label="MLABS Group">
      <span class="logo-mark">MLABS</span>
      <span class="logo-sub">GROUP</span>
    </a>
    <nav class="navlinks" aria-label={t.nav.main}>
      <a href={`${home}#vision`}>{t.nav.vision}</a>
      <a href={`${home}#nosotros`}>{t.nav.about}</a>
      <a href={`${home}#portfolio`}>{t.nav.portfolio}</a>
      <a href={`${home}#contacto`}>{t.nav.contact}</a>
    </nav>
    <div class="header-actions">
      <nav class="lang" aria-label={t.languageLabel}>
        <a href={`/es/${path}`} lang="es" aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
        <span aria-hidden="true">/</span>
        <a href={`/en/${path}`} lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </nav>
      <a href={`${home}#contacto`} class="btn">{t.headerCta}</a>
    </div>
  </div>
</header>
